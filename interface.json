{
  "$schema": "https://raw.githubusercontent.com/MaaXYZ/MaaFramework/main/tools/interface.schema.json",
  "interface_version": 2,
  "name": "MaaPJSK",
  "label": "Project SEKAI 自动化（MaaFramework）",
  "version": "0.1.0",
  "github": "https://github.com/coatcn1/MaaPJSK",
  "controller": [
    {
      "name": "Android",
      "label": "MuMu Android（1280×720）",
      "type": "Adb",
      "display_short_side": 720
    }
  ],
  "resource": [
    {
      "name": "Japanese",
      "label": "日服",
      "path": ["./resource"],
      "controller": ["Android"]
    }
  ],
  "agent": {
    "child_exec": "python",
    "child_args": ["./agent/server.py"]
  },
  "task": [
    {
      "name": "AutoLive",
      "label": "🎶 自动演出",
      "description": "从主页使用选曲页当前歌曲或点击随机选曲，并使用游戏内 AUTO LIVE 按指定次数循环；结算使用 BACK 返回主页。仅在游戏弹出体力回复页时，才按所选策略与瓶数上限使用道具。",
      "entry": "AutoLive",
      "option": ["AutoLiveSongMode", "AutoLiveCount", "AutoLiveRecoveryMode", "AutoLiveRecoveryLimit"]
    }
  ],
  "option": {
    "AutoLiveSongMode": {
      "type": "select",
      "label": "选曲方式",
      "default_case": "Current",
      "cases": [
        {
          "name": "Current",
          "label": "当前歌曲",
          "pipeline_override": {
            "AutoLiveSongModeConfig": {"custom_action_param": {"mode": "current"}}
          }
        },
        {
          "name": "Random",
          "label": "随机选取",
          "pipeline_override": {
            "AutoLiveSongModeConfig": {"custom_action_param": {"mode": "random"}}
          }
        }
      ]
    },
    "AutoLiveCount": {
      "type": "input",
      "label": "演出次数",
      "inputs": [
        {
          "name": "Count",
          "label": "次数",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^[1-9][0-9]{0,2}$",
          "pattern_msg": "请输入 1 到 999 的整数"
        }
      ],
      "pipeline_override": {
        "AutoLiveRun": {
          "custom_action_param": {"count": "{Count}"}
        }
      }
    },
    "AutoLiveRecoveryMode": {
      "type": "select",
      "label": "体力不足时使用道具",
      "default_case": "Off",
      "cases": [
        {
          "name": "Off",
          "label": "关闭（默认）",
          "pipeline_override": {
            "AutoLiveRecoveryModeConfig": {"custom_action_param": {"mode": "off"}}
          }
        },
        {
          "name": "Small",
          "label": "小饮料（每瓶 +1）",
          "pipeline_override": {
            "AutoLiveRecoveryModeConfig": {"custom_action_param": {"mode": "small"}}
          }
        },
        {
          "name": "Large",
          "label": "大饮料（每瓶 +10）",
          "pipeline_override": {
            "AutoLiveRecoveryModeConfig": {"custom_action_param": {"mode": "large"}}
          }
        }
      ]
    },
    "AutoLiveRecoveryLimit": {
      "type": "input",
      "label": "单次任务最多使用饮料",
      "inputs": [
        {
          "name": "Limit",
          "label": "瓶数上限",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^[1-9][0-9]?$",
          "pattern_msg": "请输入 1 到 99 的整数"
        }
      ],
      "pipeline_override": {
        "AutoLiveRecoveryLimitConfig": {"custom_action_param": {"limit": "{Limit}"}}
      }
    }
  }
}
